# Required for the storefront and authentication. Find these in Supabase:
# Project Settings > API.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Server-only Nuxt runtime variable. Never expose this value in NUXT_PUBLIC_* variables.
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Generate values with at least 32 characters.
CREDENTIALS_ENCRYPTION_KEY=
SHIPPING_CREDENTIALS_ENCRYPTION_KEY=
SHIPPING_WORKER_SECRET=

# Keep false until PDC launch approval.
PDC_LIVE_REQUESTS_ENABLED=false

# Legacy Daftra fallback. New connections are saved from the dashboard.
DAFTRA_ACCOUNT_URL=
DAFTRA_API_KEY=
DAFTRA_CLIENT_ID=

# Paymob: server runtime only. Live requests require separate approval.
# No legacy API key is needed by the modern Intention API.
NUXT_PAYMOB_ENABLED=false
NUXT_PAYMOB_LIVE_REQUESTS_ENABLED=false
NUXT_PAYMOB_MODE=test
NUXT_PAYMOB_SECRET_KEY=
NUXT_PAYMOB_PUBLIC_KEY=
NUXT_PAYMOB_HMAC_SECRET=
NUXT_PAYMOB_CARD_INTEGRATION_ID=
NUXT_PAYMOB_CARD_INTEGRATION_MODE=test
# Required fixed HTTPS origin for callbacks (already used for site SEO).
NUXT_PUBLIC_SITE_URL=
# Optional future registry: method => {id, mode, enabled}. Unsupported flows stay unavailable.
NUXT_PAYMOB_INTEGRATION_IDS={}

# Private, durable VPS files. Absolute canonical directory outside app/public uploads.
# Empty disables each file workflow. Provision for the application user only (0700).
NUXT_PACKING_VIDEOS_DIR=
NUXT_SHIPPING_DOCUMENTS_DIR=
# Server-only executable. Install ffprobe with FFmpeg before approved activation.
NUXT_PACKING_VIDEO_PROBE_PATH=ffprobe
