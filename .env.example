# Required for the storefront and authentication. Find these in Supabase:
# Project Settings > API.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Server-only Nuxt runtime variable. Never expose this value in NUXT_PUBLIC_* variables.
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Generate values with at least 32 characters.
CREDENTIALS_ENCRYPTION_KEY=
SHIPPING_CREDENTIALS_ENCRYPTION_KEY=
SHIPPING_WORKER_SECRET=

# Keep false until PDC launch approval.
PDC_LIVE_REQUESTS_ENABLED=false

# Legacy Daftra fallback. New connections are saved from the dashboard.
DAFTRA_ACCOUNT_URL=
DAFTRA_API_KEY=
DAFTRA_CLIENT_ID=
