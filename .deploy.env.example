# Copy this file to .deploy.env and set DEPLOY_HOST.
# Values are non-secret; SSH authentication stays in ~/.ssh.
# The SSH user, site path, PM2 app, and health URLs are locked in the scripts.

DEPLOY_HOST=your-ssh-host-or-alias
DEPLOY_PORT=22

# Optional settings.
DEPLOY_IDENTITY_FILE=
DEPLOY_BACKUP_RETENTION=5
DEPLOY_HEALTH_RETRIES=15
DEPLOY_HEALTH_DELAY=2
