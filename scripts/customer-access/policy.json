{
  "format": 1,
  "description": "Existing authenticated account read/text flows and staff customer reads; checkout, customer mutations and file uploads stay held.",
  "routes": [
    { "methods": ["GET", "HEAD"], "path": "^/(ar/)?account/(messages|support(/[0-9a-fA-F-]{36})?|after-sales(/[0-9a-fA-F-]{36})?)/?$" },
    { "methods": ["GET"], "path": "^/api/account/messages/?$" },
    { "methods": ["PATCH"], "path": "^/api/account/messages/[0-9a-fA-F-]{36}/read/?$" },
    { "methods": ["POST"], "path": "^/api/account/messages/[0-9a-fA-F-]{36}/reply/?$" },
    { "methods": ["GET"], "path": "^/api/support/(tickets(/[0-9a-fA-F-]{36})?|orders|unread)/?$" },
    { "methods": ["POST"], "path": "^/api/support/tickets(/[0-9a-fA-F-]{36}/messages)?/?$" },
    { "methods": ["PATCH"], "path": "^/api/support/tickets/[0-9a-fA-F-]{36}(/read)?/?$" },
    { "methods": ["GET"], "path": "^/api/account/after-sales/(claims(/[0-9a-fA-F-]{36}(/reverse)?)?|items|items/[0-9a-fA-F-]{36}/evidence)/?$" },
    { "methods": ["POST"], "path": "^/api/account/after-sales/(claims(/[0-9a-fA-F-]{36}/actions)?|items/[0-9a-fA-F-]{36})/?$" },
    { "methods": ["GET"], "path": "^/api/customer-users(/[0-9a-fA-F-]{36})?/?$" }
  ]
}
